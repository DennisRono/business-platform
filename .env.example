# ── Application ─────────────────────────────────────────────────────────────

PROJECT_NAME=business-platform
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1

# ── Security ────────────────────────────────────────────────────────────────

# Generate a strong secret in prod: openssl rand -hex 32
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# ── Postgres ────────────────────────────────────────────────────────────────

POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=kibet2426
POSTGRES_DB=business_platform

# ── Redis ───────────────────────────────────────────────────────────────────

REDIS_URL=redis://redis:6379/0

# ── CORS ────────────────────────────────────────────────────────────────────

# Comma-separated origins. "*" is wide-open, dev only.
BACKEND_CORS_ORIGINS=*

# ── Rate limiting ───────────────────────────────────────────────────────────

# In-memory sliding window
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
