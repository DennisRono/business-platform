# ── Application ─────────────────────────────────────────────────────────────
PROJECT_NAME=business-platform
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1

# ── Security ────────────────────────────────────────────────────────────────
# Generate a strong secret in prod: `openssl rand -hex 32`
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# ── Postgres (discrete parts; the DSN is assembled in core/config.py) ─────────
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=business_platform

# ── CORS (comma-separated origins; "*" is wide-open, dev only) ────────────────
BACKEND_CORS_ORIGINS=*

# ── Rate limiting (in-memory sliding window) ──────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ── Redis (reserved for future multi-process rate limiting / workers) ─────────
REDIS_URL=redis://localhost:6379/0
